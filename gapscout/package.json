{
  "name": "gapscout",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "GapScout - Find gaps. Fix flows. A local-first SIPOC workbench for process mapping and gap analysis.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.52.0",
    "nanoid": "^5.1.16",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-data-grid": "7.0.0-beta.58",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
