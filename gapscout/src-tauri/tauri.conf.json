{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GapScout",
  "version": "0.9.0",
  "identifier": "com.foundfirst.gapscout",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "GapScout",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Capability for the main window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:path:default",
            "sql:default",
            "sql:allow-load",
            "sql:allow-execute",
            "sql:allow-select",
            "dialog:allow-save",
            "dialog:allow-open",
            "fs:allow-write-file",
            {
              "identifier": "opener:allow-open-url",
              "allow": [{ "url": "https://github.com/mcgeand/gapscout-app/*" }]
            },
            "allow-get-db-path",
            "updater:default",
            "process:allow-restart"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwODM0NEY1ODc5RUEwQTUKUldTbG9KNkg5VVNETUtEWjVka2Y3QXJsak5Ob25kQXRNOGdBSE5KbjI1RmJrUytJUnJ1YUxvL2cK",
      "endpoints": [
        "https://github.com/mcgeand/gapscout-app/releases/latest/download/latest.json"
      ]
    }
  }
}
